# Copia este archivo como ".env" (en la misma carpeta) y completa los valores.
# ".env" NUNCA se comparte ni se versiona: contiene la clave del usuario de prueba.

# URL base del ambiente de pruebas autorizado
BASE_URL=https://opensource-demo.orangehrmlive.com

# Usuario y clave del administrador de prueba
E2E_USER=
E2E_PASSWORD=

# Semana de las fechas de prueba. 0 = el próximo lunes/martes; 1 = la semana siguiente; etc.
# Súbela si una corrida falla con "Precondición no cumplida: el empleado de prueba ya tiene
# licencias..." (otro usuario de la demo ocupó esas fechas). Opcional: si falta, vale 0.
SEMANAS_ADELANTE=0

# Token del proyecto en Percy (pruebas visuales). Solo lo usa "npm run test:percy".
PERCY_TOKEN=
