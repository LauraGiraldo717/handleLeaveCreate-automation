{
  "name": "handleleavecreate-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Automatización BDD (Cucumber.js + Playwright + Screenplay/POM) de los casos handleLeaveCreate del módulo Leave de OrangeHRM",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare-data": "node scripts/prepare-data.js",
    "template": "node scripts/create-template.js",
    "dryrun": "cucumber-js --profile dryrun",
    "test": "cucumber-js",
    "test:headed": "cucumber-js --profile headed",
    "report": "node scripts/build-report.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@playwright/test": "1.63.0",
    "dotenv": "18.0.8",
    "exceljs": "4.4.0",
    "playwright": "1.63.0"
  }
}
